# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Preferencial: secret key do projeto. Alternativamente, use a chave legada service_role.
SUPABASE_SECRET_KEY=
# Use a variável abaixo somente se sua conta ainda utiliza a chave legada service_role.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wedding-photos

# Porta local. O Render injeta PORT automaticamente.
PORT=3001
NODE_ENV=development
GUEST_SESSION_DAYS=30
